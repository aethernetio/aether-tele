include_guard(GLOBAL)
set(AE_TELEMETRY_CATALOG_TOOLS_DIR "${CMAKE_CURRENT_LIST_DIR}")

# Generate once per product, then share the same bindings with platform and
# product targets. Raw SDK and object library identities retain their own APIs.
function(ae_generate_telemetry_catalog)
  cmake_parse_arguments(TC "" "DESCRIPTOR;OUTPUT_DIR;PROFILE;NAME" "TARGETS;REPOSITORIES" ${ARGN})
  if(NOT TC_DESCRIPTOR OR NOT TC_OUTPUT_DIR)
    message(FATAL_ERROR "ae_generate_telemetry_catalog needs DESCRIPTOR and OUTPUT_DIR")
  endif()
  find_package(Python3 COMPONENTS Interpreter REQUIRED)
  get_filename_component(TC_DESCRIPTOR "${TC_DESCRIPTOR}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
  get_filename_component(TC_OUTPUT_DIR "${TC_OUTPUT_DIR}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
  set(_generator "${AE_TELEMETRY_CATALOG_TOOLS_DIR}/build_catalog.py")
  set(_arguments --descriptor "${TC_DESCRIPTOR}" --output-dir "${TC_OUTPUT_DIR}")
  get_filename_component(_tele_root "${AE_TELEMETRY_CATALOG_TOOLS_DIR}/.." ABSOLUTE)
  list(APPEND _arguments --repository "tele=${_tele_root}")
  if(DEFINED ae-numeric_SOURCE_DIR)
    list(APPEND _arguments --repository "numeric=${ae-numeric_SOURCE_DIR}")
  elseif(TARGET ae-numeric)
    get_target_property(_numeric_root ae-numeric SOURCE_DIR)
    list(APPEND _arguments --repository "numeric=${_numeric_root}")
  endif()
  if(TC_PROFILE)
    list(APPEND _arguments --profile "${TC_PROFILE}")
  endif()
  foreach(_repository IN LISTS TC_REPOSITORIES)
    list(APPEND _arguments --repository "${_repository}")
  endforeach()
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${_generator}" ${_arguments}
    RESULT_VARIABLE _result OUTPUT_VARIABLE _build_id ERROR_VARIABLE _error)
  if(NOT _result EQUAL 0)
    message(FATAL_ERROR "Telemetry catalog generation failed: ${_error}")
  endif()
  include("${TC_OUTPUT_DIR}/catalog.inputs.cmake")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${AE_TELEMETRY_CATALOG_INPUTS})
  if(NOT TC_NAME)
    string(SHA256 _target_hash "${TC_DESCRIPTOR}")
    string(SUBSTRING "${_target_hash}" 0 12 _target_hash)
    set(TC_NAME "telemetry-catalog-${_target_hash}")
  endif()
  if(NOT TARGET "${TC_NAME}")
    add_custom_command(OUTPUT "${TC_OUTPUT_DIR}/telemetry_catalog.h" "${TC_OUTPUT_DIR}/build.json"
      COMMAND "${Python3_EXECUTABLE}" "${_generator}" ${_arguments}
      DEPENDS ${AE_TELEMETRY_CATALOG_INPUTS} VERBATIM)
    add_custom_target("${TC_NAME}" DEPENDS "${TC_OUTPUT_DIR}/telemetry_catalog.h" "${TC_OUTPUT_DIR}/build.json")
  endif()
  foreach(_target IN LISTS TC_TARGETS)
    if(NOT TARGET "${_target}")
      message(FATAL_ERROR "Unknown telemetry target ${_target}")
    endif()
    get_target_property(_real_target "${_target}" ALIASED_TARGET)
    if(NOT _real_target)
      set(_real_target "${_target}")
    endif()
    add_dependencies("${_real_target}" "${TC_NAME}")
    target_include_directories("${_real_target}" PUBLIC "${TC_OUTPUT_DIR}")
    target_compile_definitions("${_real_target}" PUBLIC AE_PRODUCT_TELEMETRY_CATALOG=1)
  endforeach()
  set(AE_TELEMETRY_BUILD_MANIFEST "${TC_OUTPUT_DIR}/build.json" PARENT_SCOPE)
  set(AE_TELEMETRY_CATALOG_DIRECTORY "${TC_OUTPUT_DIR}/catalogs" PARENT_SCOPE)
endfunction()
